<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/photo_edit_toolbar"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:background="@drawable/background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/back" />

        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/back"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:text="@string/save"
            android:fontFamily="@font/montserratsemibold"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="10dp"
            android:backgroundTint="@color/white"
            android:background="@drawable/share_icon" />
    </RelativeLayout>

    <!-- Main Image (Full Screen Between Toolbar & Ads) -->
    <LinearLayout
        android:id="@+id/imageContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/photo_edit_toolbar"
        app:layout_constraintBottom_toTopOf="@+id/imagewithwatermark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:weightSum="2"
        android:padding="8dp">

        <!-- Before Image -->
        <ImageView
            android:id="@+id/beforeImage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="centerInside"

            android:background="#FFFFFF"
            android:layout_margin="4dp" />

        <!-- After Image -->
        <ImageView
            android:id="@+id/afterImage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="centerInside"

            android:background="#FFFFFF"
            android:layout_margin="4dp" />

    </LinearLayout>

    <!-- Buttons Row -->
    <LinearLayout
        android:id="@+id/buttonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"

        app:layout_constraintBottom_toBottomOf="@id/imageContainer"
        android:layout_marginBottom="@dimen/_15sdp"
        android:padding="8dp"
      >

        <!-- Before Button -->
        <TextView
            android:id="@+id/btnBefore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
           android:background="@drawable/buttonbg"
            android:text="@string/before"
            android:gravity="center"

            android:backgroundTint="@color/grey"
            android:textSize="18sp"
            android:fontFamily="@font/montserratsemibold"
            android:textColor="@android:color/white"
            android:layout_marginEnd="25dp"/>

        <!-- After Button -->
        <TextView
            android:id="@+id/btnAfter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/buttonbg"
            android:text="@string/after"
            android:gravity="center"
            android:textSize="18sp"
            android:fontFamily="@font/montserratsemibold"
            android:textColor="@android:color/white"
            android:layout_marginStart="25dp"/>


    </LinearLayout>

    <!-- Option: Image With Watermark -->
    <LinearLayout
        android:id="@+id/imagewithwatermark"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/selected_border"
        android:padding="16dp"

        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@id/imagewithoutwatermark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/watermarktext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/image_with_watermark"
            android:textSize="14sp"
            android:fontFamily="@font/montserratsemibold"
            android:textColor="#333333" />
        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/_3sdp"
            android:text="@string/download_quick_standard_quality"
            android:textSize="11sp"
            android:fontFamily="@font/montserratregular"
            android:textColor="#333232" />
    </LinearLayout>

    <!-- Option: Image Without Watermark -->
    <LinearLayout
        android:id="@+id/imagewithoutwatermark"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/unselected_border"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@id/btn_save"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/nowatermarktext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watch"
            android:textSize="14sp"
            android:textColor="#333333"
            android:fontFamily="@font/montserratsemibold" />
        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watch1"
            android:textSize="11sp"
            android:textColor="#333232"
            android:fontFamily="@font/montserratregular" />
    </LinearLayout>

    <!-- Save Button -->
    <TextView
        android:id="@+id/btn_save"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/save_now"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:gravity="center"
        android:fontFamily="@font/montserratsemibold"
        android:background="@drawable/buttonbg3"
        android:elevation="2dp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_marginHorizontal="@dimen/_25sdp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@id/adlayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ad Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adlayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Banner Ad -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_ad_containerbanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/_6sdp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/loading_layoutbanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_margin="@dimen/_1sdp"
                    android:background="@color/lightgrey"
                    android:gravity="center"
                    android:text="@string/loading_ad_"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:visibility="visible" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </androidx.cardview.widget.CardView>
        <View
            android:id="@+id/ad_placeholder"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@android:color/transparent"
            android:visibility="visible" />
        <!-- Native Ad -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_ad_containernative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/_6sdp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/loading_layoutnative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_margin="@dimen/_1sdp"
                    android:background="@color/lightgrey"
                    android:gravity="center"
                    android:text="@string/loading_ad_"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:visibility="visible" />

                <include
                    layout="@layout/native_small_button_bottom"
                    android:visibility="visible" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
