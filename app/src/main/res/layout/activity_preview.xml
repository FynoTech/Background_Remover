<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    tools:context=".MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/photo_edit_toolbar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/background">
            <ImageView
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_centerVertical="true"
                android:id="@+id/text"
                android:fontFamily="@font/montserratsemibold"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_toEndOf="@id/back"
                android:layout_height="wrap_content"
                android:text="@string/save"/>
            <ImageView
                android:id="@+id/share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="10dp"
                android:backgroundTint="@color/white"
                android:background="@drawable/share_icon" />

        </RelativeLayout>

    </FrameLayout>


    <ImageView
        android:id="@+id/imageview"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_height="250dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="67dp"
        android:id="@+id/imagewithwatermark"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:background="@drawable/selected_border"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:id="@+id/watermarktext"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/image_with_watermark"
            android:textSize="14sp"
            android:fontFamily="@font/montserratmedium"
            android:textColor="#333333"
         />



    </LinearLayout>

    <!-- High resolution image option -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="67dp"
        android:orientation="horizontal"
        android:id="@+id/imagewithoutwatermark"
        android:background="@drawable/unselected_border"
        android:padding="16dp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginBottom="15dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/nowatermarktext"
                android:text="@string/_1024px_high_resolution_image"
                android:textSize="14sp"
                android:textColor="#333333"
                android:fontFamily="@font/montserratmedium" />


        </LinearLayout>



    </LinearLayout>

    <!-- Save button -->
    <TextView
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/save_now"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:layout_marginHorizontal="@dimen/_25sdp"
        android:gravity="center"
       android:fontFamily="@font/montserratsemibold"
        android:background="@drawable/buttonbg3"
        android:elevation="2dp"
        android:layout_marginTop="16dp" />





</LinearLayout>