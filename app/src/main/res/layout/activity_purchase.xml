<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top Card with crown and close button -->
        <RelativeLayout
            android:id="@+id/topCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:layout_constraintTop_toTopOf="parent">

            <ImageView

                android:layout_width="match_parent"
                android:layout_height="280dp"
               android:layout_centerInParent="true"
                android:background="@drawable/premback"/>

            <ImageView
                android:id="@+id/closeBtn"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:padding="@dimen/_5sdp"
                android:background="@drawable/circle_gradient"
                android:layout_margin="@dimen/_15sdp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/close"/>



        </RelativeLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/premium_package"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textAllCaps="true"
            android:fontFamily="@font/montserratsemibold"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/topCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Features LinearLayout -->
        <LinearLayout
            android:id="@+id/tt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            app:layout_constraintTop_toBottomOf="@id/desc">

            <LinearLayout
                android:id="@+id/layout1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_5sdp">

                <!-- Feature Item 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:id="@+id/image1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/premiumicon"/>

                    <TextView
                        android:id="@+id/logotext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/ad_free_experience"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        app:fontFamily="@font/montserratregular"/>
                </LinearLayout>

                <!-- Feature Item 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:id="@+id/image2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/premiumicon"/>

                    <TextView
                        android:id="@+id/bustext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/faster_conversions"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        app:fontFamily="@font/montserratregular"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Feature Item 3 -->
            <LinearLayout
                android:id="@+id/layout2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="@dimen/_15sdp">

                <ImageView
                    android:id="@+id/image3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/premiumicon"/>

                <TextView
                    android:id="@+id/flyertext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/seamless_and_smooth"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    app:fontFamily="@font/montserratregular"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Pick Membership Description -->
        <TextView
            android:id="@+id/desc1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/pick_a_membership_that_fits_you"
            android:textSize="15.5sp"
            android:textColor="#000000"
            android:gravity="center"
            android:fontFamily="@font/montserratmedium"
            app:layout_constraintTop_toBottomOf="@id/tt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Price Cards -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pricelayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/desc1">

            <LinearLayout
                android:id="@+id/layout3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                android:weightSum="3"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="@dimen/_10sdp">

                <!-- Weekly Card -->
                <LinearLayout
                    android:id="@+id/cardWeekly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/unselectprem"
                    android:layout_marginHorizontal="@dimen/_5sdp">

                    <TextView
                        android:text="@string/weekly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textColor="#000"
                        android:fontFamily="@font/montserratmedium"/>

                    <TextView
                        android:id="@+id/weeklyprice"
                        android:text="PKR 300"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#000"
                        android:fontFamily="@font/montserratmedium"
                        android:paddingTop="4dp"/>

                    <TextView
                        android:text="@string/per_week"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="8sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/montserratregular"
                        android:paddingTop="2dp"/>
                </LinearLayout>

                <!-- Lifetime Card -->
                <LinearLayout
                    android:id="@+id/cardYearly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/premselected"
                    android:layout_marginHorizontal="@dimen/_5sdp">

                    <TextView
                        android:text="@string/yealry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:textColor="#000"
                        android:fontFamily="@font/montserratmedium"/>

                    <TextView
                        android:id="@+id/yearlyprice"
                        android:text="PKR 300"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#000"
                        android:fontFamily="@font/montserratmedium"
                        android:paddingTop="4dp"/>

                    <TextView
                        android:text="@string/per_year"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="8sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/montserratregular"
                        android:paddingTop="2dp"/>
                </LinearLayout>

                <!-- Monthly Card -->
                <LinearLayout
                    android:id="@+id/cardMonthly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/unselectprem"
                    android:layout_marginHorizontal="@dimen/_5sdp">

                    <TextView
                        android:text="@string/monthly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textColor="#000"
                        android:fontFamily="@font/montserratmedium"/>

                    <TextView
                        android:id="@+id/monthlyprice"
                        android:text="PKR 300"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#000"
                        android:fontFamily="@font/montserratmedium"
                        android:paddingTop="4dp"/>

                    <TextView
                        android:text="@string/per_month"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="8sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/montserratregular"
                        android:paddingTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Discount Tag -->
            <TextView
                android:id="@+id/text"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="@string/_75_off"
                android:gravity="center"
                android:textSize="10sp"
                android:visibility="visible"
                android:textColor="@color/white"
                android:background="@drawable/premtext"
                android:layout_marginTop="-10dp"
                android:fontFamily="@font/montserratmedium"
                app:layout_constraintTop_toBottomOf="@id/layout3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Purchase Button -->
        <Button
            android:id="@+id/btnPurchase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/purchase_now"
            android:textAllCaps="false"
            android:fontFamily="@font/montserratmedium"
            android:backgroundTint="@color/red"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="@dimen/_20sdp"
            app:cornerRadius="25dp"
            app:layout_constraintTop_toBottomOf="@id/pricelayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Footer -->
        <TextView
            android:id="@+id/footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/recurrent_billing_cancel_at_anytime"
            android:textSize="12sp"
            android:gravity="center"
            android:textColor="@color/black"
            android:fontFamily="@font/montserratmedium"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnPurchase"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:id="@+id/footer1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/you_can_cancel_anytime_in_your_google_play_store_settings_n_subscriptions_renew_automatically_unless_canceled_at_least_n24_hours_before_the_renewal_date"
            android:textSize="10sp"
            android:gravity="center"
            android:textColor="#3C3B3B"
            android:fontFamily="@font/montserratmedium"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="@dimen/_14sdp"
            app:layout_constraintTop_toBottomOf="@id/footer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Privacy & Terms -->
        <RelativeLayout
            android:id="@+id/layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@id/footer1">

            <TextView
                android:id="@+id/tv_Privacy"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:text="@string/privacy"
                android:gravity="center"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="5dp"
                android:fontFamily="@font/montserratregular"
                android:textColor="@color/black"
                android:textSize="13sp"/>



            <TextView
                android:id="@+id/terms"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:text="@string/terms"
                android:gravity="center"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/montserratregular"
                android:textColor="@color/black"
                android:textSize="13sp"/>
        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
