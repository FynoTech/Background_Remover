<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/in_app_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#7A000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/closeBtn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:padding="4dp"
        android:src="@drawable/close"
        android:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/titleRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="340dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratsemibold"
            android:text="@string/subscription_title_create"
            android:textColor="#FFFFFF"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/montserratsemibold"
            android:text="@string/subscription_title_background"
            android:textColor="#DD2476"
            android:textSize="32sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/titleLine2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserratsemibold"
        android:text="@string/subscription_title_without_limits"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        app:layout_constraintTop_toBottomOf="@id/titleRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="44dp"
        android:fontFamily="@font/montserratmedium"
        android:gravity="center"
        android:text="@string/subscription_subtitle"
        android:textColor="#999999"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/titleLine2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/plansRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/cardMonthly"
            android:layout_width="0dp"
            android:layout_height="148dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/sub_plan_dark"
            android:orientation="vertical"
            android:padding="8dp"
            android:gravity="center_horizontal">

            <TextView android:layout_width="match_parent" android:layout_height="30dp" android:background="@drawable/sub_badge_dark" android:gravity="center" android:text="@string/subscription_popular" android:textColor="#F4F4F4" android:textSize="12sp" android:fontFamily="@font/montserratsemibold" />
            <TextView android:id="@+id/tvMonthlyTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/subscription_plan_monthly" android:textColor="#FFFFFF" android:textSize="16sp" android:fontFamily="@font/montserratmedium" />
            <TextView android:id="@+id/monthlyprice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/sub_price_chip" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:text="$19.99" android:textColor="#FFFFFF" android:textSize="16sp" android:fontFamily="@font/montserratsemibold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardWeekly"
            android:layout_width="0dp"
            android:layout_height="148dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/sub_plan_selected"
            android:orientation="vertical"
            android:padding="8dp"
            android:gravity="center_horizontal">

            <TextView android:layout_width="match_parent" android:layout_height="30dp" android:background="@drawable/sub_badge_light" android:gravity="center" android:text="@string/subscription_trial_badge" android:lineSpacingExtra="-2dp" android:textColor="#1D1D1F" android:textSize="11sp" android:fontFamily="@font/montserratsemibold" />
            <TextView android:id="@+id/tvWeeklyTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/subscription_plan_weekly" android:textColor="#FFFFFF" android:textSize="16sp" android:fontFamily="@font/montserratmedium" />
            <TextView android:id="@+id/weeklyprice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/sub_price_chip" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:text="$6,99/week" android:textColor="#FFFFFF" android:textSize="16sp" android:fontFamily="@font/montserratsemibold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="148dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginTop="0dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/cardYearly"
                android:layout_width="match_parent"
                android:layout_height="144dp"
                android:background="@drawable/sub_plan_dark"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="@drawable/sub_badge_dark"
                    android:fontFamily="@font/montserratsemibold"
                    android:gravity="center"
                    android:text="@string/subscription_best_deal"
                    android:textColor="#F4F4F4"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvYearlyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/montserratmedium"
                    android:text="@string/subscription_plan_yearly"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/yearlyprice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/sub_price_chip"
                    android:fontFamily="@font/montserratsemibold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="$39.99"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/text"
                android:layout_width="74dp"
                android:layout_height="30dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-16dp"
                android:background="@drawable/sub_offer_badge"
                android:gravity="center"
                android:rotation="0"
                android:text="@string/_75_off"
                android:textColor="#1E1E1E"
                android:textSize="10sp"
                android:fontFamily="@font/montserratsemibold"
                android:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/ctaContainer"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/plansRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnPurchase"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/buttonbg3"
            android:fontFamily="@font/montserratsemibold"
            android:gravity="center"
            android:paddingEnd="50dp"
            android:text="@string/subscription_try_free_3_days_trial"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="7dp"
            android:background="@drawable/sub_cta_arrow_circle">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_right_pink" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/legalRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/ctaContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subscription_terms_of_use"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/montserratregular" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="6dp" android:text="|" android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tv_Privacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/privacy"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/montserratregular" />
    </LinearLayout>

    <TextView
        android:id="@+id/footer1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/montserratregular"
        android:gravity="start"
        android:text="@string/subscription_footer_text"
        android:textColor="#D0D0D0"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/legalRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
