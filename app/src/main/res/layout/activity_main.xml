<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Banner Ad -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_ad_container_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/_6sdp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/loading_layout_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/_1sdp">

            <TextView
                android:id="@+id/ad_text"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="@dimen/_1sdp"
                android:background="@color/lightgrey"
                android:gravity="center"
                android:text="@string/loading_ad_"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:visibility="visible" />
        </com.facebook.shimmer.ShimmerFrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintTop_toBottomOf="@id/cv_ad_container_banner"
        android:background="@drawable/background">
        <ImageView
            android:id="@+id/menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/ic_menu" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="@font/montserratsemibold"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:layout_toEndOf="@id/menu"
            android:layout_height="wrap_content"
            android:text="@string/background_removeal"/>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/premium"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="15dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"
            app:lottie_rawRes="@raw/premium_crown"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

    </RelativeLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_marginVertical="@dimen/_15sdp"
        android:fontFamily="@font/montserratsemibold"
        android:text="@string/erase"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Comparison Layout -->
    <androidx.cardview.widget.CardView
        android:id="@+id/comparisonLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"

        android:foreground="@drawable/ad_bg_strock"
        android:layout_marginHorizontal="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@id/text"
        app:layout_constraintDimensionRatio="317:174"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/afterImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/imagepic2" />

        <ImageView
            android:id="@+id/beforeImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/image1" />

        <View
            android:id="@+id/dividerLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@android:color/white" />

        <ImageView
            android:id="@+id/sliderHandle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/swap"
            android:layout_gravity="center_vertical"
            android:translationX="150dp" />
    </androidx.cardview.widget.CardView>

    <!-- Buttons Row -->
    <LinearLayout
        android:id="@+id/buttonsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_50sdp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/_25sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Gallery -->
        <LinearLayout
            android:id="@+id/gallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="87dp"
                android:layout_height="87dp"
                android:background="@drawable/circle_gradient"
                android:padding="25dp"
                android:src="@drawable/ic_gallery" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/montserratmedium"
                android:text="@string/gallery"
                android:textColor="@android:color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Camera -->
        <LinearLayout
            android:id="@+id/camera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="87dp"
                android:layout_height="87dp"
                android:background="@drawable/circle_gradient"
                android:padding="25dp"
                android:src="@drawable/ic_camera" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/montserratmedium"
                android:text="@string/camera"
                android:textColor="@android:color/black"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Native Ad -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_ad_container_native"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:visibility="visible"
        android:layout_marginHorizontal="@dimen/_10sdp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/_6sdp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@+id/comparisonLayout"
        app:layout_constraintBottom_toTopOf="@+id/buttonsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
       >

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/loading_layout_native"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/_1sdp">

            <include
                layout="@layout/native_advance_button_bottom"
                android:visibility="visible" />
        </com.facebook.shimmer.ShimmerFrameLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
