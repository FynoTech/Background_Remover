<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
   >

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/photo_edit_toolbar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/background">
            <ImageView
                android:id="@+id/back"
                android:layout_width="15dp"
                android:layout_height="20dp"
                android:padding="@dimen/_5sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_centerVertical="true"
                android:id="@+id/text"
                android:paddingTop="@dimen/_3sdp"
                android:fontFamily="@font/montserratsemibold"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_toStartOf="@id/done"
                android:layout_height="wrap_content"
                android:text="@string/save1"/>


            <ImageView
                android:id="@+id/done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5sdp"
                android:layout_marginStart="15dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:background="@drawable/save" />

        </RelativeLayout>

    </FrameLayout>




    <FrameLayout
        android:id="@+id/drawViewLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:background="@drawable/pngpg"
        android:layout_weight="1">

        <com.example.background_remove.DrawView
            android:id="@+id/drawView"
            android:layout_width="match_parent"
            android:visibility="visible"
            android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:gravity="center"
                android:layout_gravity="end|bottom"
                android:layout_marginBottom="@dimen/_10sdp"
                android:background="@drawable/undoredoback"
                >
                <ImageView
                    android:layout_width="wrap_content"
                    android:id="@+id/undo"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:src="@drawable/undo"
                    />
                <ImageView
                    android:layout_width="wrap_content"
                    android:id="@+id/redo"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:src="@drawable/redo"
                    />

            </LinearLayout>

    </FrameLayout>



    <FrameLayout
        android:layout_width="match_parent"
        android:id="@+id/menu"
        android:background="@color/lightgrey"
        android:layout_height="160dp">
        <LinearLayout
            android:id="@+id/colorlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"

            android:paddingHorizontal="@dimen/_5sdp"
            android:orientation="horizontal">

            <TextView

                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:layout_gravity="center"
                android:paddingStart="@dimen/_10sdp"
                android:fontFamily="@font/montserratmedium"
                android:text="@string/background_color"
                android:textColor="@color/black" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/colorRecyclerView"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:clipToPadding="false"
                android:scrollbars="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_color" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/manual_clear_settings_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="@dimen/_10sdp"
            android:visibility="visible"
            android:layout_marginHorizontal="@dimen/_5sdp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:layout_gravity="center"
                android:paddingStart="@dimen/_10sdp"
                android:fontFamily="@font/montserratmedium"
                android:text="@string/size"
                android:textColor="@color/black" />

            <SeekBar
                android:id="@+id/strokeBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:layout_gravity="center"
                android:progressBackgroundTint="@color/grey1"
                android:secondaryProgressTint="@color/grey1"
                android:progressTint="@color/red"
                android:thumbTint="@color/red"
                android:max="30"
                android:progress="15" />

        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/toolbarScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/_5sdp"
            android:elevation="@dimen/_5sdp"
            android:scrollbars="none"
            android:background="@color/white">

            <LinearLayout
                android:id="@+id/toolbarLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:weightSum="5"
                android:orientation="horizontal"
                android:gravity="center"
               >

                <!-- Auto Removal -->
                <LinearLayout
                    android:id="@+id/layoutAutoRemoval"
                    android:layout_width="wrap_content"
                    android:layout_weight="0.9"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/_5sdp"
                    android:gravity="center"
                    >

                    <ImageView
                        android:id="@+id/autoRemoval"
                        android:layout_width="24dp"
                        android:layout_marginVertical="@dimen/_5sdp"
                        android:layout_height="24dp"
                        android:src="@drawable/autor_icon_unselect"
                        />

                    <TextView
                        android:id="@+id/textAutoRemoval"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_3sdp"
                        android:text="@string/auto_removal"
                        android:textColor="@color/grey1"
                       android:fontFamily="@font/montserratsemibold"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Manual -->
                <LinearLayout
                    android:id="@+id/layoutManual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/_5sdp"
                    android:gravity="center"
                   >

                    <ImageView
                        android:id="@+id/manual"
                        android:layout_width="24dp"
                        android:layout_marginVertical="@dimen/_5sdp"
                        android:layout_height="24dp"
                        android:src="@drawable/erase_icon"
                        />

                    <TextView
                        android:id="@+id/textManual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/manual"
                        android:fontFamily="@font/montserratsemibold"
                        android:layout_marginVertical="@dimen/_3sdp"
                        android:textColor="@color/grey1"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Crop -->
                <LinearLayout
                    android:id="@+id/layoutCrop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:layout_weight="1"
                    android:paddingVertical="@dimen/_5sdp"
                    android:gravity="center"
                   >

                    <ImageView
                        android:id="@+id/crop"
                        android:layout_width="24dp"
                        android:layout_marginVertical="@dimen/_5sdp"
                        android:layout_height="24dp"
                        android:src="@drawable/crop_icon"
                       />

                    <TextView
                        android:id="@+id/textCrop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/crop"
                        android:textColor="@color/grey1"
                        android:fontFamily="@font/montserratsemibold"
                        android:layout_marginVertical="@dimen/_3sdp"

                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Repair -->
                <LinearLayout
                    android:id="@+id/layoutRepair"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="@dimen/_5sdp"
                    >

                    <ImageView
                        android:id="@+id/repair"
                        android:layout_width="24dp"
                        android:layout_marginVertical="@dimen/_5sdp"
                        android:layout_height="24dp"
                        android:src="@drawable/repair_icon"
                       />

                    <TextView
                        android:id="@+id/textRepair"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/repair"
                        android:textColor="@color/grey1"
                        android:fontFamily="@font/montserratsemibold"
                        android:layout_marginVertical="@dimen/_3sdp"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Zoom -->
                <LinearLayout
                    android:id="@+id/layoutZoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingVertical="@dimen/_5sdp"
                    android:gravity="center"
                    >

                    <ImageView
                        android:id="@+id/zoom"
                        android:layout_width="24dp"
                        android:layout_marginVertical="@dimen/_5sdp"
                        android:layout_height="24dp"
                        android:src="@drawable/zoom_icon"
                        />

                    <TextView
                        android:id="@+id/textZoom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zoom"
                        android:textColor="@color/grey1"
                        android:layout_marginVertical="@dimen/_3sdp"
                        android:fontFamily="@font/montserratsemibold"
                        android:textSize="12sp"/>
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>


    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adlayout"
        android:layout_width="match_parent"
        android:layout_gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_ad_containerbanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/_6sdp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/loading_layoutbanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/_1sdp">

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_margin="@dimen/_1sdp"
                    android:background="@color/lightgrey"
                    android:gravity="center"
                    android:text="@string/loading_ad_"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:visibility="visible" />
            </com.facebook.shimmer.ShimmerFrameLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_ad_containernative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/_6sdp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/loading_layoutnative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/_1sdp">

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_margin="@dimen/_1sdp"
                    android:background="@color/lightgrey"
                    android:gravity="center"
                    android:text="@string/loading_ad_"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:visibility="visible" />
                <include
                    layout="@layout/native_small_inline"
                    android:visibility="visible" />
            </com.facebook.shimmer.ShimmerFrameLayout>

        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>