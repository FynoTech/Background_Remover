<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    tools:context=".MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/photo_edit_toolbar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/background">
            <ImageView
                android:id="@+id/back"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:padding="15dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_centerVertical="true"
                android:id="@+id/text"
                android:fontFamily="@font/montserratsemibold"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_toEndOf="@id/back"
                android:layout_height="wrap_content"
                android:text="@string/editor"/>
            <ImageView
                android:id="@+id/undo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
               android:layout_toStartOf="@id/redo"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_centerVertical="true"
                android:background="@drawable/undo_selector" />

            <ImageView
                android:id="@+id/redo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_toStartOf="@id/done"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:background="@drawable/redo_selector" />

            <ImageView
                android:id="@+id/done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5sdp"
                android:layout_marginStart="15dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:background="@drawable/save" />

        </RelativeLayout>

    </FrameLayout>




    <FrameLayout
        android:id="@+id/drawViewLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:background="@drawable/pngpg"
        android:layout_weight="1">

        <com.example.background_remove.DrawView
            android:id="@+id/drawView"
            android:layout_width="match_parent"
            android:visibility="visible"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/loadingModal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ProgressBar
                android:id="@+id/loadingView"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </FrameLayout>

    </FrameLayout>



    <FrameLayout
        android:layout_width="match_parent"
        android:id="@+id/menu"
        android:layout_height="120dp">

        <LinearLayout
            android:id="@+id/manual_clear_settings_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Eraser size:"
                android:textColor="@color/white" />

            <SeekBar
                android:id="@+id/strokeBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:max="30"
                android:progress="15" />

        </LinearLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navView"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical"
            app:menu="@menu/bottom_nav_bar" />

    </FrameLayout>

</LinearLayout>